UID:bench-itip-001@example.com
DTSTAMP:20240401T000000Z
DTSTART:20240415T090000Z
DTEND:20240415T100000Z
SUMMARY:Bench iTIP Event 1
ORGANIZER;CN="Organizer One";SCHEDULE-AGENT=SERVER:mailto:org1@example.com
ATTENDEE;CN="Att A";ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;RSVP=TRUE;
 SCHEDULE-AGENT=SERVER:mailto:a@example.com
ATTENDEE;CN="Att B";ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;
 SCHEDULE-AGENT=SERVER;SCHEDULE-STATUS=2.0:mailto:b@example.com
ATTENDEE;CN="Att C";ROLE=OPT-PARTICIPANT;PARTSTAT=DECLINED;
 SCHEDULE-AGENT=CLIENT:mailto:c@example.com
ATTENDEE;CN="Att D";ROLE=REQ-PARTICIPANT;PARTSTAT=TENTATIVE;
 SCHEDULE-FORCE-SEND=REQUEST;SCHEDULE-STATUS=1.2:mailto:d@example.com
REQUEST-STATUS:2.0;Success
REQUEST-STATUS:1.2;Scheduling message sent
SEQUENCE:0
STATUS:CONFIRMED
END:VEVENT
