BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//mscloudx//iCalendar Lib//EN
CALSCALE:GREGORIAN
METHOD:REQUEST
BEGIN:VEVENT
UID:rfc6638-schedule-001@example.com
DTSTAMP:20240401T090000Z
DTSTART:20240410T140000Z
DTEND:20240410T150000Z
SUMMARY:RFC 6638 Schedule Parameters Demo
DESCRIPTION:Проверка параметров CalDAV-планирования (RFC 6638)
ORGANIZER;CN="Organizer";SCHEDULE-AGENT=SERVER:mailto:organizer@example.com
ATTENDEE;CN="Server Agent";ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;
 RSVP=TRUE;SCHEDULE-AGENT=SERVER:mailto:server@example.com
ATTENDEE;CN="Client Agent";ROLE=REQ-PARTICIPANT;PARTSTAT=NEEDS-ACTION;
 RSVP=TRUE;SCHEDULE-AGENT=CLIENT:mailto:client@example.com
ATTENDEE;CN="No Agent";ROLE=OPT-PARTICIPANT;PARTSTAT=DECLINED;
 SCHEDULE-AGENT=NONE:mailto:noagent@example.com
ATTENDEE;CN="Force Send";ROLE=REQ-PARTICIPANT;PARTSTAT=ACCEPTED;
 SCHEDULE-FORCE-SEND=REQUEST;SCHEDULE-STATUS=1.2:mailto:force@example.com
ATTENDEE;CN="Multi Status";ROLE=REQ-PARTICIPANT;PARTSTAT=TENTATIVE;
 SCHEDULE-STATUS=3.7:mailto:error@example.com
SEQUENCE:0
STATUS:CONFIRMED
REQUEST-STATUS:1.2;Scheduling message sent
REQUEST-STATUS:3.7;Invalid calendar user;ATTENDEE:mailto:error@example.com
END:VEVENT
END:VCALENDAR
